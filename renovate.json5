{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // policy lives in github.com/Obitrain/renovate-config (lib.json)
  extends: ["github>Obitrain/renovate-config:lib"],

  // Merge enabled updates only after checks pass on an up-to-date branch.
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    // Expo SDK 57: review these caps when upgrading the SDK and lint toolchain.
    {
      "matchPackageNames": ["@babel/core", "@babel/preset-env", "@babel/runtime"],
      "allowedVersions": "<8"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/js"],
      "allowedVersions": "<10"
    },
    {
      "matchPackageNames": ["expo"],
      "matchUpdateTypes": ["major"],
      "prBodyNotes": ["Review the Babel, TypeScript, and ESLint caps in renovate.json5 for this Expo SDK upgrade. Lift them only after Expo Doctor, lint, typecheck, and example builds pass."]
    }
  ]
}
