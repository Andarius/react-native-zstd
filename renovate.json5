{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // policy lives in github.com/Obitrain/renovate-config (lib.json)
  extends: ["github>Obitrain/renovate-config:lib"],

  // Merge enabled updates only after checks pass on an up-to-date branch.
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
