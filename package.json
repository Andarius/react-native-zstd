{
  "name": "react-native-zstd",
  "version": "1.3.4",
  "description": "ZSTD for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "externals/zstd/build/cmake",
    "externals/zstd/lib/zstd.h",
    "externals/zstd/lib/zstd_errors.h",
    "externals/zstd/lib/libzstd.pc.in",
    "externals/zstd/lib/common",
    "externals/zstd/lib/compress",
    "externals/zstd/lib/decompress",
    "!lib/typescript/example",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-zstd-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib nitrogen",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "release": "release-it",
    "bootstrap": "git submodule update --init --recursive && yarn example install",
    "pod:install": "cd example/ios && pod install",
    "pod:deintegrate": "cd example/ios && pod deintegrate && rm -rf Pods && rm Podfile.lock"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "zstd",
    "jsi"
  ],
  "repository": "https://github.com/Andarius/react-native-zstd",
  "author": "andarius <julien.brayere@obitrain.com> (https://github.com/Andarius)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Andarius/react-native-zstd/issues"
  },
  "homepage": "https://github.com/Andarius/react-native-zstd#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "commitlint": "^21.2.2",
    "conventional-changelog-angular": "^8.3.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "lefthook": "^2.1.12",
    "nitrogen": "^0.37.1",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.37.1",
    "release-it": "^20.2.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.35.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version} [skip ci]",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "version": "0.56.0"
  }
}
